class Solution {
public:
     int find_index(vector<int>&nums,int target,bool flag)
     {
        int low=0,high=nums.size()-1,c=-1;
        while(low<=high)
        {
            int mid=low+(high-low)/2;
            if(nums[mid]==target)
            {
            c=mid;
            if(flag)
            high=mid-1;
            else
            low=mid+1;
            }
            else 
            {
                if(nums[mid]< target)
                    low=mid+1;
                else
                    high=mid-1;
            }
        }
        return c;
     }
    vector<int> searchRange(vector<int>& nums, int target) {
        int first=find_index(nums,target,true);
        if(first==-1)
        return {-1,-1};
        int last=find_index(nums,target,false);
        return {first,last};
    } 
};
