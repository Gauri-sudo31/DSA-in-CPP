class Solution { 
public: 
    int jump(vector<int>& nums) { 
        int f = 0, end = 0, c = 0;

        for(int i = 0; i < nums.size() - 1; i++)
        {
            f = max(f, i + nums[i]);

            if(i == end)
            {
                c++;
                end = f;
            }
        }

        return c;
    } 
};
