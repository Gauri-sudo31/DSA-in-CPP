
class MinStack {
    stack<int> st, mn;

public:
    MinStack() {
    }
    
    void push(int value) {
        st.push(value);
        if(mn.empty() || value <= mn.top())
            mn.push(value);
        else
            mn.push(mn.top());
    }
    
    void pop() {
        st.pop();
        mn.pop();
    }
    
    int top() {
        return st.top();
    }
    
    int getMin() {
        return mn.top();
    }
};
