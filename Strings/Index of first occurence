class Solution {
public:
    int strStr(string haystack, string needle) {

        int n=haystack.size();
       for (int i = 0; i <= n - needle.size(); i++)
{
    if (haystack[i] == needle[0])
    {
        bool found = true;

        for (int j = 0; j < needle.size(); j++)
        {
            if (haystack[i+j] != needle[j])
            {
                found = false;
                break;
            }
        }

        if (found)
            return i;
    }
}

return -1;
    }
};
