class Solution {
public:
    bool isValid(string s)
    {
        char stack[s.length()];
        int top = -1;

        for(int i = 0; i < s.length(); i++)
        {
            if(s[i] == '(' || s[i] == '{' || s[i] == '[')
            {
                stack[++top] = s[i];
            }
            else
            {
                if(top == -1)
                    return false;

                char open = stack[top--];

                if((s[i] == ')' && open != '(') ||
                   (s[i] == '}' && open != '{') ||
                   (s[i] == ']' && open != '['))
                {
                    return false;
                }
            }
        }

        return top == -1;
    }
};
